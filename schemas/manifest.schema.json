{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Manifest",
    "description": "Information about a .frislet",
    "type": "object",
    "properties": {
        "title": {"type": "string"},
        "description": {
            "anyOf": [
                {"type": "string"},
                {"type": "null"}
            ]
        },
        "thumbnail": {"type": "boolean"},
        "protocol": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
    }
}